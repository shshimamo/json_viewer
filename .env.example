# Tree view: nodes at depth < N are expanded by default (default: 2)
JSON_VIEWER_TREE_DEPTH=2

# Table view: depth >= N collapses into a button (default: 3)
JSON_VIEWER_TABLE_DEPTH=3

# Directory to store saved JSON files (default: ~/.json_viewer/files)
JSON_VIEWER_DIR=

# Directory to load template YAML files (default: ~/.json_viewer/templates)
JSON_VIEWER_TEMPLATE_DIR=
